<Window x:Class="YsmConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YsmConvert.App.ViewModels"
        xmlns:conv="clr-namespace:YsmConvert.App.Converters"
        Title="YSM模型网易基岩版转换器"
        Width="1280" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:PathToImageConverter x:Key="PathToImage" />
        <Style x:Key="LogText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="error">
                    <Setter Property="Foreground" Value="#E5484D" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="warn">
                    <Setter Property="Foreground" Value="#D97706" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="notice">
                    <Setter Property="Foreground" Value="#2563EB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="detail">
                    <Setter Property="Foreground" Value="#8A8A8A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SeverityText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="error">
                    <Setter Property="Foreground" Value="#E5484D" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="warn">
                    <Setter Property="Foreground" Value="#D97706" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="notice">
                    <Setter Property="Foreground" Value="#2563EB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="info">
                    <Setter Property="Foreground" Value="#8A8A8A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="OptionText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- 状态栏 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" Margin="16,0,0,0" VerticalAlignment="Center"
                       FontFamily="Consolas, Microsoft YaHei UI" FontWeight="SemiBold" />
            <ProgressBar Grid.Column="2" Height="14" VerticalAlignment="Center" Margin="12,0,0,0"
                         Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                         IsIndeterminate="{Binding IsIndeterminate}" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1.3*" MinHeight="260" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="180" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!-- ① Java 模型包列表 -->
            <GroupBox Grid.Row="0" Grid.Column="0" Padding="6">
                <GroupBox.Header>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="① Java 模型包 (未加密目录, 含 ysm.json; 可直接把目录拖进来)" />
                </GroupBox.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                        <Button DockPanel.Dock="Left" Content="添加目录…" Command="{Binding AddPacksCommand}" Padding="10,4" Margin="0,0,6,0"
                                ToolTip="可选单个模型包目录、带 ysm-pack.json 的合集目录, 或装着若干包的上级目录(可多选)" />
                        <Button DockPanel.Dock="Left" Content="移除选中" Command="{Binding RemoveSelectedCommand}"
                                CommandParameter="{Binding ElementName=PackGrid, Path=SelectedItems}" Padding="10,4" Margin="0,0,6,0" />
                        <Button DockPanel.Dock="Left" Content="清空" Command="{Binding ClearCommand}" Padding="10,4" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" FontSize="11"
                                   Text="包名 = 模型 ID 与全部资源 ID 的词根: 小写英文/数字/下划线, 建议带作者前缀防冲突; 合集 = 模型选择界面里的文件夹" />
                    </DockPanel>
                    <DataGrid x:Name="PackGrid" ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowDetailsVisibilityMode="Collapsed" AllowDrop="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="52" />
                            <DataGridTextColumn Header="Java 文件夹" Binding="{Binding Folder}" IsReadOnly="True" Width="150" />
                            <DataGridTextColumn Header="模型名" Binding="{Binding DisplayName}" IsReadOnly="True" Width="190" />
                            <DataGridTextColumn Header="包名 (可改)" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="230" />
                            <DataGridTextColumn Header="合集 (可改)" Binding="{Binding Collection, UpdateSourceTrigger=LostFocus}" Width="120" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="150" />
                            <DataGridTextColumn Header="待过目" Binding="{Binding AttentionCount}" IsReadOnly="True" Width="72" />
                            <DataGridTextColumn Header="概况" Binding="{Binding Summary}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding JavaDir}" />
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- ② 输出与选项 -->
            <GroupBox Grid.Row="0" Grid.Column="2" Padding="8">
                <GroupBox.Header>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="② 输出与选项" />
                </GroupBox.Header>
                <!-- 操作按钮在下方结果区的页签栏右侧(见 ③), 这里整块留给选项滚动区 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <RadioButton IsChecked="{Binding IsComponentMode}" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource OptionText}" Text="新建 / 复用独立模型组件 (&lt;名&gt;_bp 与 &lt;名&gt;_rp, 与 YSM 主组件一起启用即被发现)" />
                        </RadioButton>
                        <RadioButton IsChecked="{Binding IsProjectMode}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource OptionText}" Text="写入已有的资源包 / 行为包 (选它们所在的根目录)" />
                        </RadioButton>

                        <TextBlock Text="目标根目录" Margin="0,4,0,2" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseOutputCommand}" Padding="10,4" Margin="6,0,0,0" />
                            <TextBox Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Text="组件名 (仅新建组件时用; 英文/数字/下划线)" Margin="0,8,0,2" />
                        <TextBox Text="{Binding ComponentName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsComponentMode}" />

                        <Separator Margin="0,12,0,8" />
                        <CheckBox IsChecked="{Binding UseCollection}">
                            <TextBlock Style="{StaticResource OptionText}" Text="把列表里的包归入同一个合集文件夹" />
                        </CheckBox>
                        <Grid Margin="0,6,0,0" IsEnabled="{Binding UseCollection}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="合集目录名" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CollectionDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                     ToolTip="ysm_models 下的目录名(英文/数字/下划线); 同一目录名的包在游戏里归进同一个文件夹" />
                            <TextBlock Grid.Row="1" Text="文件夹名" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CollectionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                     ToolTip="游戏里文件夹卡片上显示的名字; 不填则沿用 Java 合集自带的名字, 都没有就显示目录名" />
                            <TextBlock Grid.Row="2" Text="文件夹封面" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="清除" Command="{Binding ClearCoverCommand}" Padding="8,3" Margin="4,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="浏览…" Command="{Binding BrowseCoverCommand}" Padding="8,3" Margin="4,0,0,0" />
                                <TextBox Text="{Binding CollectionCover, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" BorderThickness="1" BorderBrush="#66888888" Width="58" Height="100" Margin="0,0,10,0"
                                        ToolTip="封面预览(按 Java 文件夹卡片 52x90 的比例)">
                                    <Image Source="{Binding CollectionCover, Converter={StaticResource PathToImage}}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="PNG, 不超过 1MB。游戏里按 Java 文件夹卡片 52x90 的比例等比铺满, 底部一截是名字区。不选则用 Java 合集自带的 ysm-pack.png, 都没有就是默认封面。贴图改动要重启游戏才会加载。" />
                            </DockPanel>
                            <Button Grid.Row="4" Grid.Column="1" Content="应用到列表里全部包的“合集”列" Command="{Binding ApplyCollectionCommand}" Padding="8,3" HorizontalAlignment="Left" />
                        </Grid>

                        <Separator Margin="0,12,0,8" />
                        <CheckBox IsChecked="{Binding CompactJson}" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource OptionText}" Text="产物 JSON 压缩为一行 (体积约省 70%, 转换更快; 要手工查看或用 git 对比时关掉)" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding ValidateAfter}" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource OptionText}" Text="转换后运行资源包红线体检 (推荐)" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding WithMods}">
                            <TextBlock Style="{StaticResource OptionText}" Text="携带第三方模组联动动画 (tacz / slashblade …, 基岩无对应物品, 一般不勾)" />
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ③ 结果 -->
            <TabControl Grid.Row="2" Grid.ColumnSpan="3" SelectedIndex="{Binding SelectedTab}">
                <TabItem Header="日志">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
                            <CheckBox Content="显示全部内核明细行" IsChecked="{Binding ShowDetails}" VerticalAlignment="Center" />
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                                       Text="红 = 错误, 橙 = 警告, 蓝 = 提醒 (内核做了降级/近似, 建议进游戏核对), 灰 = 明细" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding LogView}" x:Name="LogList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Opacity="0.5" FontSize="11" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource LogText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="开发者提醒 " />
                            <TextBlock Text="{Binding AttentionCount, StringFormat=({0})}" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock VerticalAlignment="Center" Opacity="0.75"
                                       Text="这里汇总需要人工过目的项: 基岩没有的 molang(置 0 / 按中性常量处理)、未转换的脚本控制器、缺失文件、体检错误。每项附处理建议与文档; 级别 info(灰)知道即可。" />
                            <Button Content="复制全部" Command="{Binding CopyAttentionCommand}" Padding="8,2" Margin="16,0,0,0" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Attention}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="包" Binding="{Binding Pack}" Width="150" />
                                <DataGridTemplateColumn Header="级别" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Severity}" Style="{StaticResource SeverityText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="130" />
                                <DataGridTemplateColumn Header="内容" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource WrapCell}">
                                                <Run Text="{Binding Text, Mode=OneWay}" /> <Run Text="{Binding CountText, Mode=OneWay}" Foreground="#8A8A8A" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="建议" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Advice}" Style="{StaticResource WrapCell}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="文档" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Doc}" Command="{Binding DataContext.OpenWikiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="在浏览器打开 YSM Wiki, 按这个文档名找对应章节"
                                                    Padding="4,1" FontSize="11" HorizontalAlignment="Left" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="体检">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,4" Opacity="0.75" TextWrapping="Wrap"
                                   Text="资源包红线体检: 错误 = 整份动画/控制器文件会被引擎拒载(游戏里模型停在绑定姿态), 必须修到 0; 警告 = 功能可能缺失(如音效未登记)。" />
                        <ListBox ItemsSource="{Binding ValidationItems}" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource LogText}">
                                        <Run Text="{Binding Level, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <!-- "文档"页签当按钮用: 点一下在浏览器打开线上 Wiki, 不切换页签(见 DocsTab_PreviewMouseLeftButtonDown)。
                     键盘切到这一页时显示同一个入口。 -->
                <TabItem Header="文档 ↗" ToolTip="{Binding WikiUrl}" PreviewMouseLeftButtonDown="DocsTab_PreviewMouseLeftButtonDown">
                    <StackPanel Margin="4,12,4,4">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="YSM 文档与教程" />
                        <TextBlock Margin="0,6,0,10" Opacity="0.75" TextWrapping="Wrap"
                                   Text="模型移植教程、ysm.json 格式速查、molang 替换清单与动画机制对照都在线上 Wiki。" />
                        <Button Content="在浏览器打开 Wiki" Command="{Binding OpenWikiCommand}" Padding="16,6" HorizontalAlignment="Left" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Opacity="0.6" FontSize="11" Text="{Binding WikiUrl}" />
                    </StackPanel>
                </TabItem>
                <!-- 同上: 点一下在浏览器打开转换器的开源仓库(见 RepoTab_PreviewMouseLeftButtonDown) -->
                <TabItem Header="开源地址 ↗" ToolTip="{Binding RepoUrl}" PreviewMouseLeftButtonDown="RepoTab_PreviewMouseLeftButtonDown">
                    <StackPanel Margin="4,12,4,4">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="YSM 转换器开源仓库" />
                        <TextBlock Margin="0,6,0,10" Opacity="0.75" TextWrapping="Wrap"
                                   Text="转换器的源码、发布版与问题反馈都在 GitHub 上。" />
                        <Button Content="在浏览器打开 GitHub" Command="{Binding OpenRepoCommand}" Padding="16,6" HorizontalAlignment="Left" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Opacity="0.6" FontSize="11" Text="{Binding RepoUrl}" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- 操作按钮叠在结果区页签栏右侧的空白里(页签只占左边一段), 上方 ② 整块留给选项滚动区。
                 同一格子里后声明的元素在上层, 只盖住页签栏右侧, 不挡页签和页内容 -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                <Button Content="开始转换" Command="{Binding RunCommand}" Padding="18,4" FontWeight="SemiBold" Margin="0,0,8,0"
                        ToolTip="资源包改动要重启游戏才会重新加载; 独立组件必须与 YSM 主组件一起启用。" />
                <Button Content="取消" Command="{Binding CancelCommand}" Padding="12,4" Margin="0,0,8,0" />
                <Button Content="只体检" Command="{Binding ValidateCommand}" Padding="12,4" Margin="0,0,8,0"
                        ToolTip="对已落盘的产物跑引擎红线体检(不重新转换)" />
                <Button Content="修复产物" Command="{Binding FixCommand}" Padding="12,4" Margin="0,0,8,0"
                        ToolTip="对已落盘产物就地补跑修复规则(幂等); 有 Java 源时重新转换更完整" />
                <Button Content="打开输出目录" Command="{Binding OpenOutputCommand}" Padding="10,4" Margin="0,0,8,0" />
                <Button Content="导出报告…" Command="{Binding ExportLogCommand}" Padding="10,4" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
