<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>YsmConvert</AssemblyName>
    <RootNamespace>YsmConvert.App</RootNamespace>
    <RollForward>Major</RollForward>
    <!-- exe 图标: 仓库根目录 icon.ico(由 icon.png 生成, 见 README) -->
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <!-- WPF Fluent 主题(ThemeMode)在 .NET 9/10 里标记为实验特性 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YsmConvert.Core\YsmConvert.Core.csproj" />
  </ItemGroup>

  <!--
    窗口标题栏图标不再单独嵌资源: ApplicationIcon 已把图标编进 exe 的 PE 资源, WPF 的 Window 没有显式
    Icon 时会自动用主模块的图标。早先那条 <Resource Include="..\..\icon.ico" /> 会让 icon.ico 原样
    出现在发布目录里, 看着像发布包自带的源文件, 容易被当成多余文件删掉(2026-09-18 真删过一次, 构建随即 CS7064)。
  -->

</Project>
